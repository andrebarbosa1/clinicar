rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: every collection must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // The profile bridge is intentionally scoped to the authenticated UID.
    // It must not expose another user's mapping.
    function isOwnUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOwnUserDoc(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users_by_uid/$(request.auth.uid))
        && get(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)).data.userDocId == userId;
    }

    function isValidClinicalRecord(rec) {
      return (rec.id == null || rec.id is string && rec.id.size() <= 128)
        && (rec.data == null || rec.data is string && rec.data.size() <= 50)
        && (rec.paciente == null || rec.paciente is string && rec.paciente.size() <= 150)
        && (rec.procedimento == null || rec.procedimento is string && rec.procedimento.size() <= 200)
        && (rec.dentista == null || rec.dentista is string && rec.dentista.size() <= 150)
        && (rec.status == null || rec.status == 'Realizado' || rec.status == 'Agendado' || rec.status == 'Cancelado' || rec.status == 'Pendente' || rec.status == 'Em Atendimento' || rec.status == 'Concluído')
        && (rec.statusPagamento == null || rec.statusPagamento == 'Pago' || rec.statusPagamento == 'Pendente' || rec.statusPagamento == 'Atrasado')
        && (rec.valor == null || rec.valor is number || rec.valor is int)
        && (rec.reminderSent == null || rec.reminderSent is bool || !('reminderSent' in rec))
        && (rec.reminderSentAt == null || rec.reminderSentAt is string || !('reminderSentAt' in rec));
    }

    function isValidAppUser(u) {
      return (u.id == null || u.id is string && u.id.size() <= 128)
        && (u.name == null || u.name is string && u.name.size() <= 150)
        && (u.role == null || u.role is string && u.role.size() <= 50)
        && (u.modules == null || u.modules is string && u.modules.size() <= 1000)
        && (u.username == null || u.username is string && u.username.size() <= 100)
        // Passwords are intentionally rejected from new/updated profiles.
        && !('password' in u);
    }

    function isValidPatient(p) {
      return p.id is string && p.id.size() <= 128
        && p.name is string && p.name.size() <= 150
        && (p.email == null || p.email is string && p.email.size() <= 150 || !('email' in p))
        && (p.phone == null || p.phone is string && p.phone.size() <= 50 || !('phone' in p))
        && (p.cpf == null || p.cpf is string && p.cpf.size() <= 30 || !('cpf' in p))
        && (p.createdAt == null || p.createdAt is string || !('createdAt' in p));
    }

    function isValidDocument(docObj) {
      return docObj.id is string && docObj.id.size() <= 128
        && (docObj.type == 'Atestado' || docObj.type == 'Receita' || docObj.type == 'Exame' || docObj.type == 'Outro')
        && docObj.patientName is string && docObj.patientName.size() <= 150
        && docObj.content is string && docObj.content.size() <= 10000
        && docObj.createdAt is string && docObj.createdAt.size() <= 50;
    }

    function isValidNotification(n) {
      return n.id is string && n.id.size() <= 128
        && n.message is string && n.message.size() <= 1000
        && (n.type == 'info' || n.type == 'warning' || n.type == 'error' || n.type == 'success')
        && n.read is bool
        && n.createdAt is string && n.createdAt.size() <= 50;
    }

    function isValidSupportTicket(t) {
      return t.id is string && t.id.size() <= 128
        && t.userId is string && t.userId.size() <= 128
        && t.description is string && t.description.size() <= 5000
        && (t.status == 'Pendente' || t.status == 'Em Analise' || t.status == 'Resolvido')
        && t.createdAt is string && t.createdAt.size() <= 50;
    }

    function isValidClinicSetting(s) {
      return (s.id == null || s.id is string && s.id.size() <= 128)
        && s.clinicName is string && s.clinicName.size() <= 200;
    }

    function isValidSystemAnnouncement(ann) {
      return ann.id is string && ann.id.size() <= 128
        && ann.message is string && ann.message.size() <= 2000
        && (ann.type == 'info' || ann.type == 'warning' || ann.type == 'maintenance' || ann.type == 'amber')
        && ann.active is bool
        && ann.createdAt is string && ann.createdAt.size() <= 50;
    }

    function isValidSaasCoupon(c) {
      return c.code is string && c.code.size() <= 50
        && (c.extraDays is number || c.extraDays is int)
        && (c.maxUses is number || c.maxUses is int)
        && (c.usesCount is number || c.usesCount is int)
        && c.active is bool;
    }

    function isValidLoginAttempt(la) {
      return la.username is string && la.username.size() <= 100
        && (la.attempts is number || la.attempts is int)
        && la.lastAttempt is string && la.lastAttempt.size() <= 50
        && la.blocked is bool;
    }

    function isValidDeviceAttempt(da) {
      return da.deviceId is string && da.deviceId.size() <= 128
        && (da.attempts is number || da.attempts is int)
        && (da.lastAttempt is number || da.lastAttempt is int)
        && (da.lockoutUntil is number || da.lockoutUntil is int);
    }

    function isValidOdontogram(odo) {
      return odo.patientName is string && odo.patientName.size() <= 150
        && odo.teethData is map
        && odo.lastUpdatedBy is string && odo.lastUpdatedBy.size() <= 150
        && odo.updatedAt is string && odo.updatedAt.size() <= 50;
    }

    function isValidUserByUid(u) {
      return u.userDocId is string && u.userDocId.size() <= 128
        && u.name is string && u.name.size() <= 150
        && u.role is string && u.role.size() <= 50
        && u.updatedAt is string && u.updatedAt.size() <= 50;
    }

    // Health check can remain public because it contains no patient/account data.
    match /test/connection {
      allow read: if true;
    }

    // Authentication migration: all application data requires Firebase Auth.
    // Tenant-level ownership still needs to be added to each document before
    // this policy is considered the final multi-tenant policy.
    match /records/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(recordId) && isValidClinicalRecord(incoming());
      allow delete: if isSignedIn() && isValidId(recordId);
    }

    match /users/{userId} {
      allow read: if isOwnUserDoc(userId);
      allow create: if isSignedIn() && isValidId(userId) && isValidAppUser(incoming());
      allow update: if isOwnUserDoc(userId) && isValidAppUser(incoming());
      allow delete: if isOwnUserDoc(userId);
    }

    match /users_by_uid/{uid} {
      allow read: if isOwnUid(uid);
      allow create, update: if isOwnUid(uid) && isValidUserByUid(incoming());
      allow delete: if isOwnUid(uid);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow delete: if isSignedIn() && isValidId(notificationId);
    }

    match /support_tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(ticketId) && isValidSupportTicket(incoming());
      allow delete: if isSignedIn() && isValidId(ticketId);
    }

    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(patientId) && isValidPatient(incoming());
      allow delete: if isSignedIn() && isValidId(patientId);
    }

    match /documents/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(docId) && isValidDocument(incoming());
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /odontograms/{odoId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(odoId) && isValidOdontogram(incoming());
      allow delete: if isSignedIn() && isValidId(odoId);
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(settingId) && isValidClinicSetting(incoming());
      allow delete: if isSignedIn() && isValidId(settingId);
    }

    // Login/device lockout records are not an authentication mechanism anymore.
    // They must not be publicly readable or writable.
    match /login_attempts/{username} {
      allow read, create, update, delete: if false;
    }

    match /device_attempts/{deviceId} {
      allow read, create, update, delete: if false;
    }

    match /system_announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(announcementId) && isValidSystemAnnouncement(incoming());
      allow delete: if isSignedIn() && isValidId(announcementId);
    }

    match /saas_coupons/{couponId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(couponId) && isValidSaasCoupon(incoming());
      allow delete: if isSignedIn() && isValidId(couponId);
    }
  }
}
