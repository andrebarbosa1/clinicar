rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. HELPER FUNCTIONS
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // =========================================================================
    // 2. COLLECTION RULES
    // =========================================================================

    // Connectivity Test
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Clinical Records / Consultas / Procedimentos
    match /records/{recordId} {
      allow read: if true;
      allow write: if isValidId(recordId);
    }

    // User Accounts & Team Members
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // User UID Mapping
    match /users_by_uid/{uid} {
      allow read: if true;
      allow write: if isValidId(uid);
    }

    // Patient Directory & Prontuários
    match /patients/{patientId} {
      allow read: if true;
      allow write: if isValidId(patientId);
    }

    // Clinical Documents (Receitas, Atestados, Exames)
    match /documents/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // Interactive Odontogram Data
    match /odontograms/{odoId} {
      allow read: if true;
      allow write: if isValidId(odoId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow write: if isValidId(ticketId);
    }

    // Clinic Settings & White-label Configurations
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Brute Force Lockouts (Login Attempts)
    match /login_attempts/{username} {
      allow read: if true;
      allow write: if isValidId(username);
    }

    // Device Attempts (Lockouts per device/browser fingerprint)
    match /device_attempts/{deviceId} {
      allow read: if true;
      allow write: if isValidId(deviceId);
    }

    // System Announcements & Global Banners
    match /system_announcements/{announcementId} {
      allow read: if true;
      allow write: if isValidId(announcementId);
    }

    // SaaS promotion coupons
    match /saas_coupons/{couponId} {
      allow read: if true;
      allow write: if isValidId(couponId);
    }
  }
}
