rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Global document rule to ensure unblocked read/write access
    match /{document=**} {
      allow read, write: if true;
    }

    // Collection-specific matches
    match /test/{docId} {
      allow read, write: if true;
    }

    match /records/{recordId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /users_by_uid/{uid} {
      allow read, write: if true;
    }

    match /patients/{patientId} {
      allow read, write: if true;
    }

    match /documents/{docId} {
      allow read, write: if true;
    }

    match /odontograms/{odoId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /login_attempts/{username} {
      allow read, write: if true;
    }

    match /device_attempts/{deviceId} {
      allow read, write: if true;
    }

    match /system_announcements/{announcementId} {
      allow read, write: if true;
    }

    match /saas_coupons/{couponId} {
      allow read, write: if true;
    }
  }
}

