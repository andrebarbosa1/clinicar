rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      // In this version, we allow staff operations even without Google Login 
      // primarily for the simulated environment. 
      // Security is minimal without Firebase Auth.
      return true; 
    }

    function isAdmin() {
      // For full security, re-enable Google Login and use:
      // return isSignedIn() && (request.auth.token.email == 'andreb202121@gmail.com');
      return true; 
    }

    function getUserName() {
      return "Sistema"; // Fallback when not using Google Login
    }

    // Connection Test
    match /test/connection {
      allow read: if true;
    }

    // Records Rules
    match /records/{recordId} {
      allow read, write: if true;
    }

    // User Rules
    match /users/{userId} {
      allow read, write: if true;
    }

    match /users_by_uid/{uid} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    match /patients/{patientId} {
      allow read, write: if true;
    }

    match /documents/{docId} {
      allow read, write: if true;
    }

    match /odontograms/{odoId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
